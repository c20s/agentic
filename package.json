{
  "name": "agentic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "pnpm": ">=12"
  },
  "scripts": {
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "audit:high": "pnpm audit --audit-level=high",
    "logs:tail": "tail -f ~/.claude/mcp-local-fs.summary.log",
    "logs:tail:detail": "tail -f ~/.claude/mcp-local-fs.log",
    "logs:tail:all": "tail -f ~/.claude/mcp-local-fs.summary.log ~/.claude/mcp-local-fs.log",
    "logs:tail:session": "./scripts/tail-session-logs.sh",
    "logs:clear": "truncate -s 0 ~/.claude/mcp-local-fs.summary.log ~/.claude/mcp-local-fs.log 2>/dev/null; echo 'Logs cleared.'",
    "logs:clear:detail": "truncate -s 0 ~/.claude/mcp-local-fs.log 2>/dev/null; echo 'Detail log cleared.'",
    "logs:clear:summary": "truncate -s 0 ~/.claude/mcp-local-fs.summary.log 2>/dev/null; echo 'Summary log cleared.'"
  }
}
